# ---------------------------------------------------------------------------
# 本机单机版：所有配置都只在这台电脑上生效。
# 这个文件是模板；真正的密钥请写进 .env（已被 .gitignore 忽略）。
# ---------------------------------------------------------------------------

TYPESAFE_API_KEY=
PORT=3178

# 监听地址：本机版默认只允许本机访问。
# 想在同一局域网的其它设备上打开时再改成 0.0.0.0（等于把服务暴露给同网段）。
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# 第二层：深层分析（DeepSeek）
# 默认关闭。关闭时不会产生任何 DeepSeek 请求，也不影响第一层 Jev。
# ---------------------------------------------------------------------------
DEEP_ANALYSIS_ENABLED=false
DEEP_ANALYSIS_MODEL=deepseek-flash
# 修改 prompt 语义时必须递增，否则会错误复用旧的缓存结果。当前代码默认值见
# shared/types.ts 的 DEEP_ANALYSIS_PROMPT_VERSION（不要把这里的值当成代码默认值）。
DEEP_ANALYSIS_PROMPT_VERSION=3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEP_ANALYSIS_TIMEOUT_MS=45000
